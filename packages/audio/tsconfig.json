{
  // Typage (éditeur, ESLint, `pnpm typecheck`) : sources et tests, dépendances lues depuis leurs sources.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["source"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // La musique et les instruments parcourent des tables de notes de taille fixe avec des
    // modulos (toujours dans les bornes) : cette vérification n'apporterait que du bruit.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"]
}
