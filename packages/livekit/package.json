{
  "name": "@gamecore/livekit",
  "version": "0.1.0",
  "description": "Vidéo et audio en direct pour gamecore (LiveKit) : jetons délivrés par le salon, webcams et micros, détection de parole.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gamecore/core": "workspace:*",
    "@gamecore/react": "workspace:*",
    "@gamecore/server": "workspace:*",
    "@livekit/components-react": "^2.9.24",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@gamecore/client": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.3",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
