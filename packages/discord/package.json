{
  "name": "@gamecore/discord",
  "version": "0.1.0",
  "description": "Intégration Discord de gamecore : connexion OAuth2 (PKCE), vérification d'identité côté serveur, Discord Activity.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@gamecore/core": "workspace:*",
    "@gamecore/server": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "happy-dom": "^20.14.5"
  }
}
