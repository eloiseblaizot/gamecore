{
  "name": "@gamecore/client",
  "version": "0.1.0",
  "description": "Client de jeu gamecore : connexion, reprise de session, état synchronisé, transports (Socket.io, local).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./socket-io": {
      "source": "./src/socket-io.ts",
      "types": "./dist/socket-io.d.ts",
      "import": "./dist/socket-io.js"
    },
    "./local": {
      "source": "./src/local.ts",
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gamecore/core": "workspace:*"
  },
  "peerDependencies": {
    "@gamecore/server": "workspace:*",
    "socket.io-client": "^4.8.0"
  },
  "peerDependenciesMeta": {
    "@gamecore/server": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gamecore/server": "workspace:*",
    "@types/node": "^24.19.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
