{
  // Typage (éditeur, ESLint, `pnpm typecheck`) : sources et tests, dépendances lues depuis leurs sources.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["source"],
    // Le runtime n'utilise que des API standard (Web Crypto, TextEncoder, structuredClone)
    // pour tourner aussi bien sous Node que sous Cloudflare Workers (PartyKit).
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src"]
}
